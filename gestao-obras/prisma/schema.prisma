// Esquema do banco — Fase 1 (fundação).
// Convenções: ids UUID gerados pela aplicação, datas em UTC (timestamptz),
// nomes de tabelas em snake_case. Registros históricos não são excluídos
// fisicamente: usam status/inativação.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Estrutura organizacional
// ---------------------------------------------------------------------------

/// Tipos de unidade e regras de hierarquia (configuráveis).
model OrgUnitType {
  code               String             @id @db.VarChar(40)
  name               String             @db.VarChar(120)
  isRoot             Boolean            @default(false) @map("is_root")
  allowedParentCodes String[]           @map("allowed_parent_codes")
  sortOrder          Int                @default(0) @map("sort_order")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  units              OrganizationUnit[]

  @@map("org_unit_type")
}

enum OrgUnitStatus {
  ATIVA
  INATIVA
}

model OrganizationUnit {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique @db.VarChar(40)
  name        String             @db.VarChar(200)
  typeCode    String             @map("type_code") @db.VarChar(40)
  type        OrgUnitType        @relation(fields: [typeCode], references: [code], onDelete: Restrict)
  parentId    String?            @map("parent_id") @db.Uuid
  parent      OrganizationUnit?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    OrganizationUnit[] @relation("OrgTree")
  /// Caminho materializado: "/<id raiz>/<id filho>/.../<id>/"
  path        String             @unique @db.VarChar(1000)
  depth       Int                @default(0)
  status      OrgUnitStatus      @default(ATIVA)
  street      String?            @db.VarChar(200)
  number      String?            @db.VarChar(20)
  complement  String?            @db.VarChar(100)
  district    String?            @db.VarChar(120)
  city        String?            @db.VarChar(120)
  state       String?            @db.Char(2)
  postalCode  String?            @map("postal_code") @db.VarChar(9)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?            @map("created_by_id") @db.Uuid
  updatedById String?            @map("updated_by_id") @db.Uuid
  contacts    OrgUnitContact[]
  users       User[]
  scopes      UserScope[]

  @@index([parentId])
  @@index([typeCode])
  @@map("organization_unit")
}

/// Contatos autorizados da unidade (mínimo necessário).
model OrgUnitContact {
  id        String           @id @default(uuid()) @db.Uuid
  unitId    String           @map("unit_id") @db.Uuid
  unit      OrganizationUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name      String           @db.VarChar(200)
  role      String?          @db.VarChar(120)
  email     String?          @db.VarChar(254)
  phone     String?          @db.VarChar(30)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([unitId])
  @@map("org_unit_contact")
}

// ---------------------------------------------------------------------------
// Usuários, papéis, permissões e escopos
// ---------------------------------------------------------------------------

enum UserStatus {
  ATIVO
  BLOQUEADO
  INATIVO
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(254)
  name                String               @db.VarChar(200)
  passwordHash        String               @map("password_hash") @db.VarChar(100)
  passwordChangedAt   DateTime             @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword  Boolean              @default(false) @map("must_change_password")
  status              UserStatus           @default(ATIVO)
  /// Unidade de lotação (define quem pode administrar o usuário).
  homeUnitId          String               @map("home_unit_id") @db.Uuid
  homeUnit            OrganizationUnit     @relation(fields: [homeUnitId], references: [id], onDelete: Restrict)
  /// Segredo TOTP cifrado (AES-256-GCM) — nunca em texto puro.
  mfaSecretEnc        String?              @map("mfa_secret_enc") @db.VarChar(500)
  mfaEnabledAt        DateTime?            @map("mfa_enabled_at") @db.Timestamptz(3)
  mfaLastUsedStep     BigInt?              @map("mfa_last_used_step")
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById         String?              @map("created_by_id") @db.Uuid
  updatedById         String?              @map("updated_by_id") @db.Uuid
  scopes              UserScope[]          @relation("ScopeUser")
  grantedScopes       UserScope[]          @relation("ScopeGrantedBy")
  sessions            Session[]
  recoveryCodes       MfaRecoveryCode[]
  passwordResetTokens PasswordResetToken[]

  @@index([homeUnitId])
  @@map("app_user")
}

model Permission {
  code        String           @id @db.VarChar(80)
  module      String           @db.VarChar(40)
  description String           @db.VarChar(300)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permission")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(60)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  /// Exige MFA para quem possuir este papel.
  requiresMfa Boolean          @default(false) @map("requires_mfa")
  /// Papéis de sistema não podem ser excluídos nem ter permissões reduzidas.
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions RolePermission[]
  scopes      UserScope[]

  @@map("role")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionCode String     @map("permission_code") @db.VarChar(80)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

/// Atribuição de um papel a um usuário em uma unidade organizacional.
model UserScope {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  user               User             @relation("ScopeUser", fields: [userId], references: [id], onDelete: Cascade)
  roleId             String           @map("role_id") @db.Uuid
  role               Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  unitId             String           @map("unit_id") @db.Uuid
  unit               OrganizationUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// Se verdadeiro, vale para a unidade e todas as descendentes.
  includeDescendants Boolean          @default(true) @map("include_descendants")
  grantedById        String?          @map("granted_by_id") @db.Uuid
  grantedBy          User?            @relation("ScopeGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, roleId, unitId])
  @@index([unitId])
  @@map("user_scope")
}

// ---------------------------------------------------------------------------
// Autenticação
// ---------------------------------------------------------------------------

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  /// SHA-256 do token do cookie; o token em si nunca é armazenado.
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip            String?   @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(400)

  @@index([userId])
  @@map("session")
}

/// Tentativas de autenticação. identifier = e-mail normalizado ou "mfa:<userId>".
model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(254)
  ip         String?  @db.VarChar(64)
  success    Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempt")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("mfa_recovery_code")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_token")
}

// ---------------------------------------------------------------------------
// Auditoria (append-only; UPDATE/DELETE bloqueados por trigger)
// ---------------------------------------------------------------------------

enum AuditResult {
  SUCESSO
  FALHA
  NEGADO
}

model AuditEvent {
  id            String      @id @default(uuid()) @db.Uuid
  seq           BigInt      @unique @default(autoincrement())
  occurredAt    DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId   String?     @map("actor_user_id") @db.Uuid
  actorLabel    String?     @map("actor_label") @db.VarChar(254)
  action        String      @db.VarChar(80)
  objectType    String?     @map("object_type") @db.VarChar(60)
  objectId      String?     @map("object_id") @db.VarChar(80)
  /// Unidade a que o evento pertence (usada para restringir a leitura).
  unitPath      String?     @map("unit_path") @db.VarChar(1000)
  result        AuditResult
  correlationId String      @map("correlation_id") @db.VarChar(64)
  ip            String?     @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.VarChar(400)
  metadata      Json?
  prevHash      String      @map("prev_hash") @db.Char(64)
  hash          String      @db.Char(64)

  @@index([occurredAt])
  @@index([actorUserId])
  @@index([action])
  @@index([objectType, objectId])
  @@map("audit_event")
}
