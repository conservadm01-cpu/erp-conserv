{
  "name": "gestao-obras",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Gestão de Obras — proposta técnica independente",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "jobs:daily": "tsx scripts/daily-jobs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.999.0",
    "@aws-sdk/s3-request-presigner": "3.999.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "15.5.28",
    "nodemailer": "7.0.13",
    "otplib": "12.0.1",
    "pdfkit": "0.17.2",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/pdfkit": "0.17.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.21",
    "dotenv": "16.6.1",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
