# ---------------------------------------------------------------------------
# Gestão de Obras — variáveis de ambiente
# Copie para .env e ajuste. Nunca versione o arquivo .env.
# ---------------------------------------------------------------------------

# Banco de dados (PostgreSQL 16). Com o docker-compose deste projeto:
DATABASE_URL="postgresql://obras:obras_dev@localhost:5432/obras?schema=public"

# Bancos usados pelos testes automatizados (o nome DEVE terminar em _test;
# eles são apagados e recriados a cada execução).
TEST_DATABASE_URL="postgresql://obras:obras_dev@localhost:5432/obras_test?schema=public"
E2E_DATABASE_URL="postgresql://obras:obras_dev@localhost:5432/obras_e2e_test?schema=public"

# Endereço público da aplicação (usado em links de e-mail e na verificação de origem).
APP_URL="http://localhost:3000"

# Chave de 32 bytes em base64 para cifrar segredos de MFA.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obrigatória em produção. Em desenvolvimento, se ausente, usa uma chave fixa de teste.
APP_ENCRYPTION_KEY=""

# Sessão: expiração por inatividade (minutos) e absoluta (horas).
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Defina true somente atrás de proxy reverso confiável (usa X-Forwarded-For/Proto).
TRUST_PROXY=false

# E-mail: console (padrão em desenvolvimento), memory (testes) ou smtp.
MAIL_DRIVER="console"
MAIL_FROM="Gestão de Obras <nao-responda@exemplo.test>"
# Para MAIL_DRIVER=smtp (com o Mailpit do docker-compose: SMTP_HOST=localhost, SMTP_PORT=1025):
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""

# Seed: "demo" (dados fictícios) ou "base" (somente estrutura + administrador inicial).
# SEED_MODE="base"
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_NAME=""
# SEED_ROOT_NAME="Gestão Central"

NEXT_TELEMETRY_DISABLED=1
