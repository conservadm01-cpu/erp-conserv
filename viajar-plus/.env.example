# =============================================================================
# VIAJAR+ — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA versione valores reais. Variáveis NEXT_PUBLIC_* vão para o navegador;
# todas as demais ficam APENAS no servidor.
# =============================================================================

# --- Supabase (banco, autenticação e armazenamento) --------------------------
# Sem estas duas, o app roda em "modo demonstração local" (IndexedDB, sem login).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Usada exclusivamente na exclusão de conta (LGPD).
# Sem ela, a exclusão automática da conta fica indisponível.
SUPABASE_SERVICE_ROLE_KEY=

# --- Voos, hotéis e atividades: Amadeus for Developers -----------------------
# Verifique a disponibilidade atual do programa e os termos de uso antes de usar.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (dados de teste, cobertura limitada) ou "production"
AMADEUS_ENV=test

# --- Voos: Duffel (alternativa) ----------------------------------------------
DUFFEL_ACCESS_TOKEN=

# --- OpenStreetMap (Nominatim/Overpass) ---------------------------------------
# A política de uso do Nominatim exige identificar a aplicação e um contato.
NOMINATIM_USER_AGENT=ViajarMais/0.1
CONTACT_EMAIL=
# Opcional: instâncias próprias/alternativas (separe por vírgula)
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# --- Provedores fictícios (somente desenvolvimento) ---------------------------
# Com "true" e NODE_ENV=development, as pesquisas sem credenciais retornam
# resultados FICTÍCIOS claramente marcados. Ignorado em produção.
ENABLE_MOCK_PROVIDERS=false

# --- Limites de upload (MB) ---------------------------------------------------
# Também ajuste file_size_limit dos buckets em supabase/migrations/0003_storage.sql
# e o limite global de upload do seu plano Supabase.
NEXT_PUBLIC_MAX_IMAGE_MB=40
NEXT_PUBLIC_MAX_VIDEO_MB=1024
NEXT_PUBLIC_MAX_AUDIO_MB=100
NEXT_PUBLIC_MAX_DOCUMENT_MB=20

# --- Extras das integrações (ver docs/INTEGRACOES.md) ---
# URL base da Amadeus (o Self-Service foi encerrado em 2026; use a URL do contrato Enterprise, se houver)
AMADEUS_BASE_URL=
# Instância própria do Overpass (recomendado em produção); vazio = endpoints públicos com fallback
OVERPASS_URL=
# E-mail de contato enviado no User-Agent das APIs do OpenStreetMap (política de uso)
OSM_CONTACT_EMAIL=
